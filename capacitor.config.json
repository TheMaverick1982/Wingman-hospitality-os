{
  "appId": "com.joinwingman.app",
  "appName": "Wingman",
  "webDir": "native/www",
  "server": {
    "url": "https://www.joinwingman.app",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "joinwingman.app",
      "www.joinwingman.app",
      "*.joinwingman.app"
    ]
  },
  "ios": {
    "contentInset": "always"
  },
  "backgroundColor": "#0a6cff",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": true,
      "backgroundColor": "#0a6cff",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashImmersive": false
    }
  }
}
